# Copie para .streamlit/secrets.toml (local) e cole o conteúdo nos Secrets do Streamlit Cloud.
# NUNCA suba o secrets.toml para o GitHub (já está no .gitignore).

[app]
emails_permitidos = ["seu-email@gmail.com", "segundo-email@gmail.com"]
# Só para rodar no seu computador sem login Google. NÃO use no Streamlit Cloud.
# dev_email = "seu-email@gmail.com"
# dev_nome  = "Seu nome"

[connections.neon]
# Neon > Connect > "Connection string" (troque o início por postgresql+psycopg://)
url = "postgresql+psycopg://USUARIO:SENHA@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

[auth]
redirect_uri = "https://SEU-APP.streamlit.app/oauth2callback"   # local: http://localhost:8501/oauth2callback
cookie_secret = "cole-aqui-uma-string-aleatoria-longa"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Próximos módulos (câmera, projeções, IR):
# [anthropic]
# api_key = "sk-ant-..."
